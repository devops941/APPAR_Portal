FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm install

COPY . .

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV WATCHPACK_POLLING=true

EXPOSE 3000

CMD ["sh", "-c", "if [ ! -d '/app/node_modules/next' ]; then npm install; fi && npm run dev -- -H 0.0.0.0 -p 3000"]
